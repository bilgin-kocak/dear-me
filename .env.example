# Copy to .env for local runs (npm start reads it). On a host, set these as environment variables.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
PUBLIC_BASE_URL=https://dear-me.example.org
# Comma-separated Telegram user ids allowed to use /village and /demo_seed
ADMIN_TG_IDS=111111111
UNLOCK_AT=2027-10-31T20:00:00+05:30
DB_PATH=data/dear-me.db
# A long random secret. Never change it after launch: consents, /mine and /burn depend on it.
HASH_SALT=replace-with-output-of-openssl-rand-base64-32
PORT=3000
