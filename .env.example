# Copy to .env for local runs (npm start reads it). On a host, set these as environment variables.

# Without a token, npm start serves only the web pages. Uncomment and set it to run the bot.
# TELEGRAM_BOT_TOKEN=123456789:your-bot-token

# Required when the bot runs: a long random secret, e.g. the output of `openssl rand -base64 32`.
# Never change it after launch: consents, /mine and /burn depend on it.
HASH_SALT=

PUBLIC_BASE_URL=https://dear-me.example.org
# Comma-separated Telegram user ids allowed to use /village and /demo_seed
ADMIN_TG_IDS=111111111
# Must include the timezone offset
UNLOCK_AT=2027-10-31T20:00:00+05:30
DB_PATH=data/dear-me.db
PORT=3000
